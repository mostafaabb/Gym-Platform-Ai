# Core Application Settings
APP_NAME="GymFlow AI"
APP_VERSION=1.0.0
ENVIRONMENT=production  # development | production | testing
DEBUG=false

# Backend Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BACKEND_CORS_ORIGINS=["https://gymflowai.com", "https://gymflow-frontend.onrender.com", "http://localhost:3000"]

# Database Configuration (PostgreSQL)
# For local dev: postgresql+psycopg://postgres:password@localhost:5432/gymflow
# For production (Render): connection string provided by Render
DATABASE_URL=postgresql+psycopg://user:password@hostname:5432/dbname
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Security & JWT
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=yoursupersecretproductionkeyhere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@gymflowai.com

# AI Features (OpenAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4-turbo
WHISPER_MODEL=whisper-1

# Stripe Payments
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=gymflow-uploads
AWS_S3_REGION=us-east-1

# Feature Flags
ENABLE_STRIPE=false
ENABLE_AWS_S3=false
ENABLE_AI_FEATURES=true
ENABLE_POSE_DETECTION=true
ENABLE_WEBSOCKETS=true

# Frontend Public Variables (Next.js)
NEXT_PUBLIC_API_URL=https://gymflow-backend.onrender.com/api/v1
NEXT_PUBLIC_WS_URL=wss://gymflow-backend.onrender.com/ws
